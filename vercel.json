{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run setup",
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.data-of-japan.org"
        }
      ],
      "destination": "https://data-of-japan.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "japan-election.visualizing.jp"
        }
      ],
      "destination": "https://data-of-japan.org/politics/elections/:path",
      "permanent": true
    },
